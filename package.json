{
  "name": "dsh-in-hand",
  "version": "1.7.1",
  "description": "掌上 DSH：DeepSeek Harness 的手机端，不用装 App——会话、实时对话、交付文件、后台任务与待批准。 / DSH in hand: the phone client for DeepSeek Harness with no app to install.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "phone",
    "mobile",
    "client",
    "pwa",
    "remote",
    "monitor",
    "observability"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-bundle.mjs && node scripts/check-files.mjs && node scripts/check-uploads.mjs && node scripts/check-queue.mjs && node scripts/check-entries.mjs",
    "demo": "node scripts/make-demo.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingchenhui0618-arch/dsh-in-hand.git"
  },
  "homepage": "https://github.com/dingchenhui0618-arch/dsh-in-hand#readme",
  "bugs": {
    "url": "https://github.com/dingchenhui0618-arch/dsh-in-hand/issues"
  },
  "author": "dingchenhui0618-arch",
  "license": "Apache-2.0"
}
